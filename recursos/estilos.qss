QWidget {
    color: #F8EDF3;
    font-family: "Segoe UI";
    font-size: 10pt;
}

QWidget#ventanaPrincipal {
    background-color: #171217;
}

QFrame#sidebar {
    background-color: #211821;
    border-right: 1px solid #392633;
}

QLabel#marca {
    color: #F4A7C5;
    font-size: 19pt;
    font-weight: bold;
}

QLabel#submarca {
    color: #BBA8B5;
    font-size: 9pt;
}

QLabel#tituloBarra {
    color: #FFF5FA;
    font-size: 12pt;
    font-weight: bold;
}

QLabel#tituloPagina {
    color: #FFF5FA;
    font-size: 23pt;
    font-weight: bold;
}

QLabel#descripcion {
    color: #BBA8B5;
    font-size: 10pt;
}

QLabel#etiquetaRosa {
    color: #F4A7C5;
    font-weight: bold;
}

QPushButton#nav {
    background-color: transparent;
    color: #E6D9E2;
    border: none;
    border-radius: 9px;
    padding: 12px;
    text-align: left;
    font-size: 10pt;
}

QPushButton#nav:hover {
    background-color: #382636;
    color: #FFFFFF;
}

QPushButton#nav[active="true"] {
    background-color: #D94685;
    color: #FFFFFF;
    font-weight: bold;
}

QFrame#tarjeta {
    background-color: #29202B;
    border: 1px solid #463143;
    border-radius: 14px;
}

QLabel#numeroTarjeta {
    color: #F4A7C5;
    font-size: 23pt;
    font-weight: bold;
}

QLabel#tituloTarjeta {
    color: #FFF5FA;
    font-size: 11pt;
    font-weight: bold;
}

QFrame#barraSuperior {
    background-color: #1D161F;
    border-bottom: 1px solid #392633;
}

QLineEdit#busqueda {
    background-color: #251D27;
    color: #FFF5FA;
    border: 1px solid #594154;
    border-radius: 8px;
    padding: 11px;
    selection-background-color: #D94685;
}

QLineEdit#busqueda:focus {
    border: 1px solid #F4A7C5;
}

QTableWidget#tablaDatos {
    background-color: #211A23;
    alternate-background-color: #29202B;
    color: #F8EDF3;
    border: 1px solid #463143;
    border-radius: 8px;
    gridline-color: #392633;
    selection-background-color: #743454;
    selection-color: #FFFFFF;
}

QHeaderView::section {
    background-color: #382636;
    color: #F4A7C5;
    border: none;
    padding: 10px;
    font-weight: bold;
}

QTableWidget QTableCornerButton::section {
    background-color: #382636;
    border: none;
}

QScrollBar:vertical {
    background: #211821;
    width: 9px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #80506D;
    border-radius: 4px;
    min-height: 25px;
}

QScrollBar::handle:vertical:hover {
    background: #D94685;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}